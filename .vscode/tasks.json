{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PIO Build (teensy31)",
            "type": "shell",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "run",
                "-e",
                "teensy31"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "PIO Upload (teensy31)",
            "type": "shell",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "run",
                "-e",
                "teensy31",
                "-t",
                "upload"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "PIO Clean (teensy31)",
            "type": "shell",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "run",
                "-e",
                "teensy31",
                "-t",
                "clean"
            ],
            "problemMatcher": []
        }
    ]
}
